                        <properties>
                          <font name="Lexend" size="22" style="1"/>
                          <text value=""/>
                        </properties>
                      </component>
                      <component id="boardButton7" class="javax.swing.JButton" binding="boardButton7">
                        <constraints>
                          <grid row="2" column="0" row-span="1" col-span="1" vsize-policy="3" hsize-policy="3" anchor="0" fill="3" indent="0" use-parent-layout="false"/>
                        </constraints>
                        <properties>
                          <font name="Lexend" size="22" style="1"/>
                          <text value=""/>
                        </properties>
                      </component>
                      <component id="boardButton8" class="javax.swing.JButton" binding="boardButton8">
                        <constraints>
                          <grid row="2" column="1" row-span="1" col-span="1" vsize-policy="3" hsize-policy="3" anchor="0" fill="3" indent="0" use-parent-layout="false"/>
                        </constraints>
                        <properties>
                          <font name="Lexend" size="22" style="1"/>
                          <text value=""/>
                        </properties>
                      </component>
                      <component id="boardButton9" class="javax.swing.JButton" binding="boardButton9">
                        <constraints>
                          <grid row="2" column="2" row-span="1" col-span="1" vsize-policy="3" hsize-policy="3" anchor="0" fill="3" indent="0" use-parent-layout="false"/>
                        </constraints>
                        <properties>
                          <font name="Lexend" size="22" style="1"/>
                          <text value=""/>
                        </properties>
                      </component>
                    </children>
                  </grid>
                </children>
              </grid>
              <grid id="gameInfoPanel" binding="gameInfoPanel" layout-manager="GridBagLayout">
                <constraints border-constraint="East"/>
                <properties/>
                <border type="none"/>
                <children>
                  <grid id="gameInfoLabelPanel" binding="gameInfoLabelPanel" layout-manager="GridBagLayout">
                    <constraints>
                      <grid row="0" column="0" row-span="1" col-span="1" vsize-policy="3" hsize-policy="3" anchor="5" fill="3" indent="0" use-parent-layout="false"/>
                      <gridbag top="2" left="5" bottom="2" right="5" weightx="1.0" weighty="2.0"/>
                    </constraints>
                    <properties/>
                    <border type="none"/>
                    <children>
                      <component id="sessionTime" class="javax.swing.JLabel" binding="sessionTime">
                        <constraints>
                          <grid row="0" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="3" anchor="5" fill="0" indent="0" use-parent-layout="false"/>
                          <gridbag top="2" left="5" bottom="2" right="5" weightx="1.0" weighty="0.0"/>
                        </constraints>
                        <properties>
                          <horizontalAlignment value="4"/>
                          <text value="Session Time: "/>
                        </properties>
                      </component>
                      <component id="gamesPlayed" class="javax.swing.JLabel" binding="gamesPlayed">
                        <constraints>
                          <grid row="1" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="3" anchor="5" fill="0" indent="0" use-parent-layout="false"/>
                          <gridbag top="2" left="5" bottom="2" right="5" weightx="1.0" weighty="0.0"/>
                        </constraints>
                        <properties>
                          <horizontalAlignment value="4"/>
                          <text value="Games Played: "/>
                        </properties>
                      </component>
                      <component id="roundsPlayed" class="javax.swing.JLabel" binding="roundsPlayed">
                        <constraints>
                          <grid row="2" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="3" anchor="5" fill="0" indent="0" use-parent-layout="false"/>
                          <gridbag top="2" left="5" bottom="2" right="5" weightx="1.0" weighty="0.0"/>
                        </constraints>
                        <properties>
                          <horizontalAlignment value="4"/>
                          <text value="Rounds Played: "/>
                        </properties>
                      </component>
                      <component id="turnsPlayed" class="javax.swing.JLabel" binding="turnsPlayed">
                        <constraints>
                          <grid row="3" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="3" anchor="5" fill="0" indent="0" use-parent-layout="false"/>
                          <gridbag top="2" left="5" bottom="2" right="5" weightx="1.0" weighty="0.0"/>
                        </constraints>
                        <properties>
                          <horizontalAlignment value="4"/>
                          <text value="Turns Played: "/>
                        </properties>
                      </component>
                      <component id="p1RoundsWon" class="javax.swing.JLabel" binding="p1RoundsWon">
                        <constraints>
                          <grid row="4" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="3" anchor="5" fill="0" indent="0" use-parent-layout="false"/>
                          <gridbag top="2" left="5" bottom="2" right="5" weightx="1.0" weighty="0.0"/>
                        </constraints>
                        <properties>
                          <horizontalAlignment value="4"/>
                          <text value="P1 Rounds Won: "/>
                        </properties>
                      </component>
                      <component id="p2RoundsWon" class="javax.swing.JLabel" binding="p2RoundsWon">
                        <constraints>
                          <grid row="5" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="3" anchor="5" fill="0" indent="0" use-parent-layout="false"/>
                          <gridbag top="2" left="5" bottom="2" right="5" weightx="1.0" weighty="0.0"/>
                        </constraints>
                        <properties>
                          <horizontalAlignment value="4"/>
                          <text value="P2 Rounds Won: "/>
                        </properties>
                      </component>
                      <component id="gameInfoSpacer" class="javax.swing.JPanel">
                        <constraints>
                          <grid row="6" column="0" row-span="1" col-span="1" vsize-policy="3" hsize-policy="3" anchor="0" fill="2" indent="0" use-parent-layout="false"/>
                          <gridbag top="2" left="5" bottom="2" right="5" weightx="1.0" weighty="1.0"/>
                        </constraints>
                        <properties/>
                      </component>
                    </children>
                  </grid>
                  <component id="continueButton" class="javax.swing.JButton" binding="continueButton">
                    <constraints>
                      <grid row="1" column="0" row-span="1" col-span="1" vsize-policy="3" hsize-policy="3" anchor="0" fill="3" indent="0" use-parent-layout="false">
                        <preferred-size width="125" height="40"/>
                      </grid>
                      <gridbag top="2" left="5" bottom="2" right="5" weightx="1.0" weighty="1.0"/>
                    </constraints>
                    <properties>
                      <text value="Continue"/>
                    </properties>
                  </component>
                </children>
              </grid>
            </children>
          </grid>
        </children>
      </grid>
    </children>
  </grid>
</form>
