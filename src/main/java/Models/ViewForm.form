<?xml version="1.0" encoding="UTF-8"?>
<form xmlns="http://www.intellij.com/uidesigner/form/" version="1" bind-to-class="Models.ViewForm">
  <grid id="rootPanel" binding="root" layout-manager="CardLayout" hgap="0" vgap="0">
    <constraints>
      <xy x="20" y="20" width="800" height="480"/>
    </constraints>
    <properties/>
    <border type="none"/>
    <children>
      <grid id="menuPanel" binding="menuPanel" layout-manager="BorderLayout" hgap="0" vgap="0">
        <constraints>
          <card name="MENU"/>
        </constraints>
        <properties/>
        <border type="none"/>
        <children>
          <component id="menuTitleLabel" class="javax.swing.JLabel" binding="menuTitleLabel">
            <constraints border-constraint="Center"/>
            <properties>
              <horizontalAlignment value="0"/>
              <horizontalTextPosition value="0"/>
              <text value="Velha"/>
            </properties>
          </component>
          <grid id="bottomMenu" binding="bottomMenu" layout-manager="GridLayoutManager" row-count="2" column-count="1" same-size-horizontally="false" same-size-vertically="true" hgap="0" vgap="0">
            <margin top="0" left="0" bottom="0" right="0"/>
            <constraints border-constraint="South"/>
            <properties/>
            <border type="none"/>
            <children>
              <grid id="menuPlayerInfoPanel" binding="menuPlayerInfoPanel" layout-manager="GridLayoutManager" row-count="1" column-count="5" same-size-horizontally="true" same-size-vertically="false" hgap="0" vgap="0">
                <margin top="0" left="0" bottom="0" right="0"/>
                <constraints>
                  <grid row="0" column="0" row-span="1" col-span="1" vsize-policy="3" hsize-policy="3" anchor="0" fill="3" indent="0" use-parent-layout="false"/>
                </constraints>
                <properties/>
                <border type="none"/>
                <children>
                  <grid id="p1NameSelectPanel" binding="p1NameSelectPanel" layout-manager="GridLayoutManager" row-count="2" column-count="1" same-size-horizontally="false" same-size-vertically="true" hgap="0" vgap="0">
                    <margin top="0" left="0" bottom="0" right="0"/>
                    <constraints>
                      <grid row="0" column="0" row-span="1" col-span="1" vsize-policy="3" hsize-policy="3" anchor="0" fill="3" indent="0" use-parent-layout="false"/>
                    </constraints>
                    <properties/>
                    <border type="none"/>
                    <children>
                      <component id="p1NameInputLabel" class="javax.swing.JLabel" binding="p1NameInputLabel">
                        <constraints>
                          <grid row="0" column="0" row-span="1" col-span="1" vsize-policy="3" hsize-policy="0" anchor="8" fill="0" indent="0" use-parent-layout="false"/>
                        </constraints>
                        <properties>
                          <horizontalAlignment value="2"/>
                          <text value="Name:"/>
                        </properties>
                      </component>
                      <component id="p1NameTextField" class="javax.swing.JTextField" binding="p1NameTextField">
                        <constraints>
                          <grid row="1" column="0" row-span="1" col-span="1" vsize-policy="3" hsize-policy="6" anchor="0" fill="3" indent="0" use-parent-layout="false">
                            <preferred-size width="150" height="-1"/>
                          </grid>
                        </constraints>
                        <properties/>
                      </component>
                    </children>
                  </grid>
                  <grid id="p1CharSelectPanel" binding="p1CharSelectPanel" layout-manager="GridLayoutManager" row-count="2" column-count="1" same-size-horizontally="false" same-size-vertically="true" hgap="0" vgap="0">
                    <margin top="0" left="0" bottom="0" right="0"/>
                    <constraints>
                      <grid row="0" column="1" row-span="1" col-span="1" vsize-policy="3" hsize-policy="3" anchor="0" fill="3" indent="0" use-parent-layout="false"/>
                    </constraints>
                    <properties/>
                    <border type="none"/>
                    <children>
                      <component id="p1CharInputLabel" class="javax.swing.JLabel" binding="p1CharInputLabel">
                        <constraints>
                          <grid row="0" column="0" row-span="1" col-span="1" vsize-policy="3" hsize-policy="0" anchor="8" fill="0" indent="0" use-parent-layout="false"/>
                        </constraints>
                        <properties>
                          <horizontalAlignment value="2"/>
                          <text value="P1 character:"/>
                        </properties>
                      </component>
                      <component id="p1CharTextField" class="javax.swing.JTextField" binding="p1CharTextField">
                        <constraints>
                          <grid row="1" column="0" row-span="1" col-span="1" vsize-policy="3" hsize-policy="6" anchor="0" fill="3" indent="0" use-parent-layout="false">
                            <preferred-size width="150" height="-1"/>
                          </grid>
                        </constraints>
                        <properties>
                          <text value="X"/>
                        </properties>
                      </component>
                    </children>
                  </grid>
                  <component id="sameCharWarningLabel" class="javax.swing.JLabel" binding="sameCharWarningLabel">
                    <constraints>
                      <grid row="0" column="2" row-span="1" col-span="1" vsize-policy="3" hsize-policy="3" anchor="0" fill="1" indent="0" use-parent-layout="false"/>
                    </constraints>
                    <properties>
                      <foreground color="-65536"/>
                      <horizontalAlignment value="0"/>
                      <text value=""/>
                    </properties>
                  </component>
                  <grid id="p2CharSelectPanel" binding="p2CharSelectPanel" layout-manager="GridLayoutManager" row-count="2" column-count="1" same-size-horizontally="false" same-size-vertically="true" hgap="0" vgap="0">
                    <margin top="0" left="0" bottom="0" right="0"/>
                    <constraints>
                      <grid row="0" column="3" row-span="1" col-span="1" vsize-policy="3" hsize-policy="3" anchor="0" fill="3" indent="0" use-parent-layout="false"/>
                    </constraints>
                    <properties/>
                    <border type="none"/>
                    <children>
                      <component id="p2CharInputLabel" class="javax.swing.JLabel" binding="p2CharInputLabel">
                        <constraints>
                          <grid row="0" column="0" row-span="1" col-span="1" vsize-policy="3" hsize-policy="0" anchor="8" fill="0" indent="0" use-parent-layout="false"/>
                        </constraints>
                        <properties>
                          <horizontalAlignment value="2"/>
                          <text value="P2 character:"/>
                        </properties>
                      </component>
                      <component id="p2CharTextField" class="javax.swing.JTextField" binding="p2CharTextField">
                        <constraints>
                          <grid row="1" column="0" row-span="1" col-span="1" vsize-policy="3" hsize-policy="6" anchor="0" fill="3" indent="0" use-parent-layout="false">
                            <preferred-size width="150" height="-1"/>
                          </grid>
                        </constraints>
                        <properties>
                          <text value="O"/>
                        </properties>
                      </component>
                    </children>
                  </grid>
                  <grid id="p2NameSelectPanel" binding="p2NameSelectPanel" layout-manager="GridLayoutManager" row-count="2" column-count="1" same-size-horizontally="false" same-size-vertically="true" hgap="0" vgap="0">
                    <margin top="0" left="0" bottom="0" right="0"/>
                    <constraints>
                      <grid row="0" column="4" row-span="1" col-span="1" vsize-policy="3" hsize-policy="3" anchor="0" fill="3" indent="0" use-parent-layout="false"/>
                    </constraints>
                    <properties/>
                    <border type="none"/>
                    <children>
                      <component id="p2NameInputLabel" class="javax.swing.JLabel" binding="p2NameInputLabel">
                        <constraints>
                          <grid row="0" column="0" row-span="1" col-span="1" vsize-policy="3" hsize-policy="0" anchor="8" fill="0" indent="0" use-parent-layout="false"/>
                        </constraints>
                        <properties>
                          <horizontalAlignment value="2"/>
                          <text value="Name:"/>
                        </properties>
                      </component>
                      <component id="p2NameTextField" class="javax.swing.JTextField" binding="p2NameTextField">
                        <constraints>
                          <grid row="1" column="0" row-span="1" col-span="1" vsize-policy="3" hsize-policy="6" anchor="0" fill="3" indent="0" use-parent-layout="false">
                            <preferred-size width="150" height="-1"/>
                          </grid>
                        </constraints>
                        <properties/>
                      </component>
                    </children>
                  </grid>
                </children>
              </grid>
              <grid id="buttonGridPanel" binding="buttonGridPanel" layout-manager="GridLayoutManager" row-count="1" column-count="5" same-size-horizontally="true" same-size-vertically="false" hgap="0" vgap="0">
                <margin top="0" left="0" bottom="0" right="0"/>
                <constraints>
                  <grid row="1" column="0" row-span="1" col-span="1" vsize-policy="3" hsize-policy="3" anchor="0" fill="3" indent="0" use-parent-layout="false"/>
                </constraints>
                <properties/>
                <border type="none"/>
                <children>
                  <hspacer id="menuSpacer1">
                    <constraints>
                      <grid row="0" column="0" row-span="1" col-span="1" vsize-policy="3" hsize-policy="3" anchor="0" fill="1" indent="0" use-parent-layout="false"/>
                    </constraints>
                  </hspacer>
                  <hspacer id="menuSpacer2">
                    <constraints>
                      <grid row="0" column="1" row-span="1" col-span="1" vsize-policy="3" hsize-policy="3" anchor="0" fill="1" indent="0" use-parent-layout="false"/>
                    </constraints>
                  </hspacer>
                  <component id="playButton" class="javax.swing.JButton" binding="playButton">
                    <constraints>
                      <grid row="0" column="2" row-span="1" col-span="1" vsize-policy="3" hsize-policy="3" anchor="0" fill="3" indent="0" use-parent-layout="false"/>
                    </constraints>
                    <properties>
                      <text value="Play"/>
                    </properties>
                  </component>
                  <hspacer id="menuSpacer3">
                    <constraints>
                      <grid row="0" column="3" row-span="1" col-span="1" vsize-policy="3" hsize-policy="3" anchor="0" fill="1" indent="0" use-parent-layout="false"/>
                    </constraints>
                  </hspacer>
                  <hspacer id="menuSpacer4">
